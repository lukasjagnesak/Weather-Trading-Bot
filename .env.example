# ══════════════════════════════════════════════════════════════
# Weather Trading Bot — Configuration
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   chmod 600 .env
#   nano .env

# ─── Polymarket Credentials (required for live trading) ─────
# Create a DEDICATED wallet for trading — never use your main wallet!
# Export private key from MetaMask: Settings → Security → Export
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=

# Signature type: 0=EOA (MetaMask/hardware), 1=Email/Magic wallet
POLYMARKET_SIGNATURE_TYPE=0

# ─── Trading Mode ──────────────────────────────────────────
# "paper" = dry-run (no real trades, just logging)
# "live"  = real trades on Polymarket (requires credentials above)
TRADING_MODE=paper

# ─── Risk Parameters ──────────────────────────────────────
# Start conservative, increase after you verify performance!
BANKROLL=200.0
MAX_POSITION_PCT=0.02       # Max 2% of bankroll per position ($4 on $200)
MIN_EDGE_THRESHOLD=0.10     # Only trade when model edge > 10%
KELLY_FRACTION=0.25         # Quarter Kelly — conservative sizing
DAILY_LOSS_LIMIT_PCT=0.15   # Stop trading if down 15% today
MAX_DRAWDOWN_PCT=0.25       # Reduce sizes at 25% drawdown from peak

# ─── Scan Settings ─────────────────────────────────────────
SCAN_INTERVAL=300            # Seconds between scans (300 = 5 min)
# ACTIVE_CITIES=["nyc","london","paris","tokyo","seoul","shanghai"]

# ─── Telegram Notifications (recommended for live trading) ─
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Message @userinfobot to get your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TRADE_ALERTS=true
TELEGRAM_DAILY_REPORT=true
TELEGRAM_DAILY_REPORT_HOUR=7

# ─── Copy-Trading (optional) ──────────────────────────────
# COPY_TRADE_ENABLED=false
# COPY_TRADE_MIN_WALLETS=2
# COPY_TRADE_SCALE=0.5
