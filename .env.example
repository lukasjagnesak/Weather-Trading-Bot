# Polymarket Trading Credentials
# Required only for live trading (not needed for paper trading / signal generation)
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=

# Signature type: 0=EOA (MetaMask), 1=Email/Magic wallet
POLYMARKET_SIGNATURE_TYPE=0

# Trading mode: "paper" or "live"
TRADING_MODE=paper

# Risk parameters — tuned for $200 paper bankroll
BANKROLL=200.0
MAX_POSITION_PCT=0.02
MIN_EDGE_THRESHOLD=0.10
KELLY_FRACTION=0.25
DAILY_LOSS_LIMIT_PCT=0.15
MAX_DRAWDOWN_PCT=0.25

# Scan interval (seconds) — 5 minutes default
# SCAN_INTERVAL=300

# Active cities (comma-separated)
# ACTIVE_CITIES=["nyc","london","paris","tokyo","seoul","shanghai"]

# Telegram notifications
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Message @userinfobot to get your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TRADE_ALERTS=true
TELEGRAM_DAILY_REPORT=true
TELEGRAM_DAILY_REPORT_HOUR=7

# Copy-trading settings
# COPY_TRADE_ENABLED=false
# COPY_TRADE_MIN_WALLETS=2
# COPY_TRADE_SCALE=0.5
